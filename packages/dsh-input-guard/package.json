{
    "name": "@michengai/dsh-input-guard",
    "version": "0.1.7",
    "private": false,
    "description": "在发送前拦截 DSH 输入框中的密钥与个人信息，并支持可配置的词条映射替换",
    "license": "Apache-2.0",
    "type": "module",
    "packageManager": "pnpm@11.22.0",
    "main": "lib/index.mjs",
    "types": "lib/index.d.mts",
    "exports": {
        ".": {
            "types": "./lib/index.d.mts",
            "default": "./lib/index.mjs"
        },
        "./client": {
            "default": "./lib/client.js"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "lib",
        "cordis.patch.yml",
        "README.md",
        "README.zh-CN.md",
        "CHANGELOG.md",
        "LICENSE",
        "NOTICE"
    ],
    "dsh": {
        "bundle": {
            "patch": "./cordis.patch.yml"
        },
        "client": {
            "platform": "web",
            "inject": [
                "@deepseek-ai/dsh-client-runtime",
                "@deepseek-ai/dsh-client-locale",
                "@deepseek-ai/dsh-client-ui-conversation",
                "@deepseek-ai/dsh-client-ui-input-trigger"
            ]
        }
    },
    "engines": {
        "node": "^22.19.0 || >=24.0.0"
    },
    "scripts": {
        "build": "tsdown",
        "typecheck": "tsc --noEmit -p tsconfig.json",
        "test": "pnpm run typecheck && vitest run && tsdown && node tests/bundle.assert.mjs",
        "check": "pnpm test"
    },
    "keywords": [
        "deepseek-harness",
        "dsh",
        "input-guard",
        "secret-scanning",
        "pii",
        "cordis"
    ],
    "publishConfig": {
        "access": "public",
        "registry": "https://registry.npmjs.org/"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/MichengAI/dsh-codex-ui.git",
        "directory": "packages/dsh-input-guard"
    },
    "bugs": {
        "url": "https://github.com/MichengAI/dsh-codex-ui/issues"
    },
    "homepage": "https://github.com/MichengAI/dsh-codex-ui/tree/main/packages/dsh-input-guard#readme",
    "peerDependencies": {
        "@deepseek-ai/cordis": ">=4.0.2 <5.0.0",
        "@deepseek-ai/dsh-client-locale": ">=0.1.0-rc.5 <0.2.0",
        "@deepseek-ai/dsh-client-runtime": ">=0.1.0-rc.5 <0.2.0",
        "@deepseek-ai/dsh-client-ui-conversation": ">=0.1.0-rc.5 <0.2.0",
        "@deepseek-ai/dsh-client-ui-input-trigger": ">=0.1.0-rc.5 <0.2.0",
        "@deepseek-ai/dsh-client-ui-slots": ">=0.1.0-rc.5 <0.2.0",
        "react": "^18.2.0",
        "react-dom": "^18.2.0"
    },
    "devDependencies": {
        "@deepseek-ai/cordis": "4.0.2",
        "@deepseek-ai/dsh-api-session-controller": "0.1.2-rc.1",
        "@deepseek-ai/dsh-client-locale": "0.1.2-rc.1",
        "@deepseek-ai/dsh-client-runtime": "0.1.1-rc.2",
        "@deepseek-ai/dsh-client-ui-conversation": "0.1.2-rc.1",
        "@deepseek-ai/dsh-client-ui-input-trigger": "0.1.2-rc.1",
        "@deepseek-ai/dsh-client-ui-slots": "0.1.2-rc.1",
        "@deepseek-ai/dsh-session": "0.1.2-rc.1",
        "@types/node": "^26.0.0",
        "@types/react": "~18.3.1",
        "jsdom": "^29.1.1",
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "tsdown": "^0.22.2",
        "typescript": "^6.0.3",
        "vitest": "^4.1.8"
    }
}